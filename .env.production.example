# Production environment variables
POSTGRES_PASSWORD=your-strong-password
JWT_SECRET=your-jwt-secret-at-least-32-chars
MICROMDM_URL=https://mdm.example.com
MICROMDM_API_KEY=your-api-key
WEBSOCKET_URL=websocket.example.com
VPP_TOKEN_PATH=
# Encrypts secrets stored in the database (Google Calendar credentials, user directory API key).
# Generate with: openssl rand -base64 32   -- and back it up: if it is lost, the stored secrets cannot be recovered.
SETTINGS_ENCRYPTION_KEY=
WEB_PORT=3000
