# MDM Server Configuration
# Copy this file to .env and fill in the values

# Server
LISTEN_ADDR=:8080

# PostgreSQL
DATABASE_URL=postgres://mdm:mdm@localhost:5432/mdm?sslmode=disable

# JWT (use a strong random string, at least 32 characters)
JWT_SECRET=change-me-in-production

# Auth cookie Secure flag. Defaults to true (fail-safe) — browsers refuse to
# send a Secure cookie over plain HTTP, so local HTTP development must set
# this to false explicitly. Never set to false in production.
COOKIE_SECURE=true

# MicroMDM
MICROMDM_URL=https://mdm.example.com
MICROMDM_API_KEY=your-api-key-here

# Apple VPP (optional)
VPP_TOKEN_PATH=

# Webhook
WEBHOOK_PATH=/webhook

# SocketIO webhook relay server (connects as client to receive MDM events)
WEBSOCKET_URL=https://websocket.example.com

# CORS (comma-separated origins, used in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === SMTP (outgoing mail: rental/maintenance/disposal notifications) ===
# Loaded at boot as the initial config; the Settings page can also set/override
# this at runtime (stored in the mail_settings table, hot-reloaded).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=MDM 管理平台
SMTP_TLS=true
# If the mail server's certificate is signed by an internal/private CA (fails
# with "x509: certificate signed by unknown authority"), point this at a PEM
# file containing that CA's certificate — it's trusted IN ADDITION TO the
# system's default trust store. (Can also be pasted directly in the Settings
# page instead of using this env var.)
SMTP_CA_CERT_PATH=
# Last-resort escape hatch if the CA certificate above isn't available.
# Disables TLS certificate verification entirely — insecure, prefer
# SMTP_CA_CERT_PATH whenever possible.
SMTP_INSECURE_SKIP_VERIFY=false

# === SSO / OIDC ===
# Leave OIDC_CLIENT_ID empty to disable SSO (password login remains available).
# OIDC_REDIRECT_URL must match the Redirect URI registered in your IdP.
# OIDC_ISSUER_URL examples:
#   Google:    https://accounts.google.com
#   Azure AD:  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak:  https://keycloak.example.com/realms/<realm>
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://mdm.example.com/api/auth/sso/callback

# === Apple Business Manager API (for DEP auto-assignment) ===
# Get these from Apple Business Manager → Preferences → API → your API account.
# The PEM is the EC P-256 private key you uploaded the public half of.
# Leave DEP_AUTO_ASSIGN=false until you've placed template files in DEP_TEMPLATE_DIR.
ABM_KEY_PATH=/path/to/abm-private-key.pem
ABM_CLIENT_ID=BUSINESSAPI.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ABM_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ABM_TEAM_ID=    # optional, defaults to ABM_CLIENT_ID (Apple's sample uses same value)
# ABM_SCOPE=business.api    # default

# === DEP auto-assignment scheduler ===
# Template files: $DEP_TEMPLATE_DIR/{mac,ipad,iphone,appletv}.json
# Each template is a full DEP profile body (same shape as
# `mdmctl apply dep-profiles -f` consumes). Leave the "devices" field empty —
# the scheduler fills it in per device.
DEP_TEMPLATE_DIR=./dep-profiles
DEP_POLL_INTERVAL=5m
DEP_AUTO_ASSIGN=false   # master switch — set to true to enable the scheduler
